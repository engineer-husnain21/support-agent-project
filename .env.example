# Copy this file to ".env" and fill in your real values.
# Never push .env to GitHub.
LLM_API_KEY=your_key_here
LLM_BASE_URL=your_provider_base_url
LLM_MODEL=your_model_name

# Base URL examples (confirm against the provider's docs):
#   Groq:       https://api.groq.com/openai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1     (any key works, e.g. "ollama")
# Copy the model name from the provider's current model list (names change over time).

# Optional: saves tokens with reasoning models (e.g. gpt-oss). Remove this line if it causes an error.
# LLM_REASONING_EFFORT=low

# Optional second provider (a backup for long evaluation runs, because free daily limits are small).
# Example: Google AI Studio (Gemini). Use "python list_models.py 2" to see the exact model names.
# LLM2_API_KEY=your_second_key
# LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM2_MODEL=model_name_from_list_models
