# Is file ko copy karke ".env" naam se save karo aur apni asli values likho.
# .env ko kabhi GitHub pe push mat karna.
LLM_API_KEY=yahan_apni_key_likho
LLM_BASE_URL=yahan_provider_ka_base_url
LLM_MODEL=yahan_model_ka_naam

# Base URL examples (provider ki docs se confirm kar lena):
#   Groq:       https://api.groq.com/openai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1     (key kuch bhi, jaise "ollama")
# Model ka naam provider ki current model list se copy karo (naam badalte rehte hain).
